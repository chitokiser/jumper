// /firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ??怨멸껀?????筌???遊붋?筌뤾쑬裕?筌뤾퍔???
    function isOperatorEmail() {
      return signedIn()
        && (request.auth.token.email is string)
        && (request.auth.token.email == "daguri75@gmail.com");
    }

    function isAdmin() {
      return signedIn()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || isOperatorEmail()
        );
    }

    // orders ??節딇꺑????ｇ춯???⑤베裕???뚮맍瑗???띠럾????獄??????
    function isOrderBuyer() {
      return signedIn()
        && (resource.data.buyerUid is string)
        && resource.data.buyerUid == request.auth.uid;
    }

    function isOrderGuide() {
      return signedIn()
        && (resource.data.guideUid is string)
        && resource.data.guideUid == request.auth.uid;
    }

    // ??뚮맍瑗??? ??瑜곸젧 ?띠럾??繞③뇡???? "?롪퍒??節륁??紐낅뭶 ?熬곣뫗????怨쀬Ŧ ???ル┰
    function buyerPayProofUpdateOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["proof","paymentStatus","payProofUpdatedAt"]);
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ??ㅻ쾴?????notices)
    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // ?띠럾????獄????????ル―???(guideApplications/{uid})
    match /guideApplications/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create: if signedIn() && request.auth.uid == uid;

      // ??FIX: ??㉱?洹먮봿????獄????꾩룇瑗??嶺뚳퐣瑗?怨?ご??熬곥굥??update ?띠럾??繞③뜮????      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow delete: if isAdmin();
    }

    // ?띠럾????獄??熬곣뫁夷??(guides/{uid})
    match /guides/{uid} {
      allow get: if isAdmin()
                || (signedIn() && request.auth.uid == uid)
                || (resource.data.approved == true);
      allow list: if isAdmin();

      // ??FIX: ?獄???????㉱?洹먮봿?썸뤆?쎛 guides/{uid}????諛댁뎽??怨룻뒍 ??濡ル츎 ??댟??怨룸츩?띠럾? 嶺뚮씭???      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;
    }

    // ??⑤갭?(items)
    match /items/{itemId} {

      function isOwner() {
        return signedIn() && (
          (resource.data.ownerUid is string && resource.data.ownerUid == request.auth.uid)
          || (resource.data.guideUid is string && resource.data.guideUid == request.auth.uid)
        );
      }

      function isPublicItem() {
        return (resource.data.status in ["published", "approved"]);
      }

      allow get: if isAdmin() || isOwner() || isPublicItem();
      allow list: if true;

      allow create: if signedIn()
        && (request.resource.data.ownerUid is string)
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAdmin() || isOwner();

      allow delete: if isAdmin()
        || (signedIn() && (resource.data.ownerUid is string) && resource.data.ownerUid == request.auth.uid);

      match /reviews/{uid} {
        allow get, list: if isAdmin() || isPublicItem() || isOwner();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    // ?洹먮맧??(SSOT)
    match /reviews/{orderId} {

      function orderExistsAndMine() {
        return signedIn()
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.buyerUid == request.auth.uid
          && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.paymentStatus in ["confirmed","settled","completed"]
            || get(/databases/$(database)/documents/orders/$(orderId)).data.status in ["confirmed","settled","completed"]
          );
      }

      function isReviewAuthor() {
        return signedIn()
          && (resource.data.authorUid is string)
          && resource.data.authorUid == request.auth.uid;
      }

      function isReviewGuide() {
        return signedIn()
          && (resource.data.guideUid is string)
          && resource.data.guideUid == request.auth.uid;
      }

      function authorUpdateOnly() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(["rating","text","updatedAt"]);
      }

      function guideReplyOnly() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(["guideReply","updatedAt"]);
      }

      allow get, list: if true;

      allow create: if orderExistsAndMine()
        && (request.resource.data.authorUid is string)
        && request.resource.data.authorUid == request.auth.uid
        && (request.resource.data.orderId == orderId);

      allow update: if isAdmin()
        || (isReviewAuthor() && authorUpdateOnly())
        || (isReviewGuide() && guideReplyOnly());

      allow delete: if isAdmin();
    }

    // ?낅슣?뽪룇(orders)
    match /orders/{orderId} {
      allow get: if isAdmin() || isOrderBuyer() || isOrderGuide();
      allow list: if signedIn();

      allow create: if signedIn()
        && (request.resource.data.buyerUid is string)
        && request.resource.data.buyerUid == request.auth.uid;

      allow update: if isAdmin()
        || (isOrderBuyer() && buyerPayProofUpdateOnly());

      allow delete: if isAdmin();
    }

    // slots
    match /slots/{slotId} {
      allow get, list: if true;

      allow create: if signedIn()
        && (request.resource.data.itemId is string)
        && (request.resource.data.date is string)
        && (request.resource.data.capacity is number)
        && (request.resource.data.booked is number)
        && request.resource.data.booked >= 0
        && request.resource.data.capacity >= 0;

      allow update: if signedIn()
        && (resource.data.booked is number)
        && (request.resource.data.booked is number)
        && request.resource.data.booked >= resource.data.booked;

      allow delete: if isAdmin();
    }

    // users/{uid}
    match /users/{uid} {
      // ??FIX: ??㉱?洹먮봿???獄?????role/profile???影??꽑???????admin create/update ???깅뮔
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow list, delete: if isAdmin();

      // 泥댄뿕 ????媛쒖씤 留??꾩씠??(蹂몄씤留??쎄린/?곌린, 理쒕? 50媛쒕뒗 ?대씪?댁뼵???쒗븳)
      match /myMap/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // settlements
    match /settlements/{ym} {
      allow get: if isAdmin() || signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /guides/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // (???뺥깴?? settlementRuns
    match /settlementRuns/{ym} {
      allow get: if isAdmin() || signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /guides/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // guideOrders
    match /guideOrders/{guideUid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == guideUid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /orders/{orderId} {
        allow get, list: if isAdmin() || (signedIn() && request.auth.uid == guideUid);
        allow create, update, delete: if isAdmin();
      }
    }

    // settings
    match /settings/{docId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
    // ??臾롫쭜??嶺뚯솘???????ル맪????롫맩???    // 嶺뚮ㅄ維獄???⑤슢???Cloud Functions(Admin SDK)??嶺뚳퐣瑗??????????怨룹꽘??write ?釉띾쐡?됀
    // ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????

    // ??믨퀣???寃몃쳴????븐슙??(deposits/{refCode})
    // - ???: ???六????븐슙?뺟춯???袁ⓥ뵛 ?띠럾???    // - ??㉱?洹먮봿?? ?熬곣뫕????袁ⓥ뵛
    // - ??⑤슢?? Cloud Functions嶺?(??????怨룹꽘??嶺뚯쉳?????⑤슢???釉띾쐡?됀)
    match /deposits/{refCode} {
      allow get: if isAdmin()
        || (signedIn()
            && resource.data.uid is string
            && resource.data.uid == request.auth.uid);

      allow list: if isAdmin()
        || (signedIn()
            && resource.data.uid is string
            && resource.data.uid == request.auth.uid);

      allow create, update, delete: if false; // Cloud Functions(Admin SDK) ?熬곣뫗??
    }

        // mentors (mentors/{email})
    match /mentors/{email} {
      allow get, list: if signedIn();
      allow create, update, delete: if false; // Cloud Functions only
    }

    // mentorRequests ??硫섑넗 ?곌껐 ?붿껌
    match /mentorRequests/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // transactions (transactions/{docId})
    match /transactions/{docId} {
      allow get: if isAdmin()
        || (signedIn()
            && resource.data.uid is string
            && resource.data.uid == request.auth.uid);

      allow list: if isAdmin()
        || (signedIn()
            && resource.data.uid is string
            && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false; // Cloud Functions only
    }

    // kca_webzine (AI 留덉????뱀쭊)
    match /kca_webzine/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // merchants (merchants/{merchantId})
    match /merchants/{merchantId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow delete: if false; // Cloud Functions only
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerUid is string
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['career', 'region', 'description', 'updatedAt']));
    }

    // places (places/{placeId})
    match /places/{placeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // coop config
    match /coopConfig/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // coop products
    match /coopProducts/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // coop orders
    match /coopOrders/{orderId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }
    // sponsor banners
    match /sponsorBanners/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // jackpot rounds (怨듦컻 ?듦퀎 議고쉶??
    match /jackpot_rounds/{roundId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // jackpot wins ???꾩씠????뙚 ?뱀꺼 湲곕줉 (怨듦컻 ?쎄린)
    match /jackpot_wins/{docId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // jackpot config ????뙚 ?꾩쟻湲덉븸 罹먯떆 (怨듦컻 ?쎄린)
    match /jackpot_config/{docId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Cloud Functions only
    }
// used market posts
    match /usedMarketPosts/{postId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.sellerUid is string
        && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn()
            && resource.data.sellerUid is string
            && resource.data.sellerUid == request.auth.uid);
    }

    // ohlc (HEX/KRW 罹붾뱾 李⑦듃 ?곗씠?? ??怨듦컻 ?쎄린
    match /ohlc/{docId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }


    // ?? 蹂대Ъ李얘린 ?쒖뒪??????????????????????????????????????????????
    match /treasure_items/{docId} {
      allow get, list: if true;           // ?꾩씠???뺣낫 怨듦컻
      allow write: if false;              // Cloud Function only
    }
    match /treasure_keys/{docId} {
      allow get, list: if true;           // ?댁뇿 ?뺤쓽 怨듦컻 (?대씪?댁뼵???쒕엻瑜??쒖떆??
      allow write: if false;              // Cloud Function only
    }
    match /treasure_boxes/{docId} {
      allow get, list: if true;           // 諛뺤뒪 ?꾩튂 怨듦컻 (吏???쒖떆)
      allow write: if false;
    }
    match /treasure_inventory/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /treasure_logs/{docId} {
      allow get: if signedIn()
        && docId.matches(request.auth.uid + '_.*');
      allow list: if isAdmin();
      allow write: if false;
    }
    match /treasure_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /treasure_vouchers/{docId} {
      allow get, list: if true;
      allow write: if false;
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /treasure_voucher_logs/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /treasure_inventory_boxes/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /treasure_voucher_purchases/{docId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // 諛붾떏 ?쒕엻 ??濡쒓렇???좎? ?꾧뎄???쎄린, ?곌린???쒕쾭 ?꾩슜
    match /dropped_items/{docId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // ?? ?꾩튂 湲곕컲 ?꾪닾 ?쒖뒪???????????????????????????????????????
    match /battle_monsters/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /battle_towers/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /map_decorations/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /battle_players/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if true; // ??궧 怨듦컻 (Hunter Ranking)
      // gold ?꾨뱶??Cloud Functions(Admin SDK)留?蹂寃?媛?????대씪?댁뼵??吏곸젒 ?곌린 湲덉?
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['gold']);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gold']);
      allow delete: if isAdmin();
    }

    // ?? Zen Spark 而ㅻ??덊떚 寃뚯떆??????????????????????????????????????
    // ?몄쬆? ??Jump ID) ?덈꺼?먯꽌 泥섎━ ??Firestore???꾨뱶 議댁옱/援ъ“留?寃利?
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.authorId is string
        && request.resource.data.authorId.size() > 0;
      allow update: if true;
      allow delete: if true;
    }

    // ?? ?뚯뀥 而ㅻ??덊떚 (community_events) ?????????????????????????????
    match /community_events/{eventId} {
      allow get, list: if true;                        // ?꾧뎄???쎄린
      allow create: if isAdmin();                      // 愿由ъ옄留??깅줉
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);

      // ?됱젏(?꾧린) ?쒕툕而щ젆????臾몄꽌 ID = uid (1??1?꾧린), 愿由ъ옄???먯쑀 ID
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isAdmin()             // 愿由ъ옄: ?먰븯???대쫫쨌ID濡??먯쑀 ?깅줉
          || (signedIn()
              && reviewId == request.auth.uid  // ?쇰컲 ?좎?: 蹂몄씤 uid濡쒕쭔
              && !exists(/databases/$(database)/documents/community_events/$(eventId)/reviews/$(request.auth.uid)));
        allow update, delete: if isAdmin();
      }

      // ?볤? ?쒕툕而щ젆??
      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // 而ㅻ??덊떚 ?됱궗 諛붿슦泥?(community_event_vouchers/{uid_eventId})
    match /community_event_vouchers/{docId} {
      allow get: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Cloud Function only
    }

    // 諛붿슦泥??뺤궛 (community_voucher_settlements/{docId})
    match /community_voucher_settlements/{docId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow write: if false; // Cloud Function only
    }

    // ?? 踰꾧린移??몄텧 ?쒕퉬??????????????????????????????????????????????
    // ?깅줉??湲곗궗 ?щ? ?뺤씤
    function isRegisteredDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/buggy_drivers/$(request.auth.uid));
    }

    match /buggy_config/{docId} {
      allow get, list: if true;
      allow write: if false; // Cloud Function only
    }
    match /buggy_rides/{rideId} {
      // 蹂몄씤 ?몄텧, 諛곗젙??湲곗궗, ?깅줉 湲곗궗(searching ?섏떊??, 愿由ъ옄
      allow get: if isAdmin()
        || isRegisteredDriver()
        || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid));
      allow list: if isAdmin()
        || isRegisteredDriver()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.driverId == request.auth.uid);
      allow write: if false; // Cloud Function only
    }
    match /buggy_drivers/{driverUid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == driverUid);
      allow list: if isAdmin();
      allow write: if false; // Cloud Function only
    }
    match /buggy_driver_locations/{driverUid} {
      allow get, list: if signedIn();                              // ?묒듅?먮룄 ?ㅼ떆媛??꾩튂 議고쉶
      allow write: if signedIn() && request.auth.uid == driverUid; // 湲곗궗 蹂몄씤 吏곸젒 write
    }
    match /buggy_transactions/{docId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // Cloud Function only
    }
    match /ride_audit_logs/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /payment_attempt_logs/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /buggy_driver_earnings/{docId} {
      allow get: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    // ?? DAO ?섍껐 ?쒖뒪??????????????????????????????????????????????
    // ?덇굔 紐⑸줉쨌?곸꽭: ?꾧뎄???쎄린 媛??
    // ?깅줉쨌吏吏쨌?ы몴쨌?볤?: Cloud Function ?쒕쾭 ?ъ씠??泥섎━ (吏곸젒 ?곌린 遺덇?)
    match /dao_proposals/{proposalId} {
      allow get, list: if true;
      allow write: if false; // Cloud Function留??곌린 媛??

      match /supporters/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin();
        allow write: if false;
      }
      match /votes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin();
        allow write: if false;
      }
      match /comments/{commentId} {
        allow get, list: if true;
        allow write: if false;
      }
    }

    // ?? 寃뚯엫 ?곸젏 (game_shops) ???????????????????????????????????????
    match /game_shops/{shopId} {
      allow get, list: if true;                        // 吏???쒖떆??怨듦컻 ?쎄린
      allow create, update, delete: if isAdmin();      // 愿由ъ옄留?諛곗튂/?섏젙/??젣
    }

    // ?? ?곸젏 ?먮ℓ 濡쒓렇 (shop_sales_logs) ?????????????????????????????
    match /shop_sales_logs/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false; // Cloud Function only
    }

    // ?? ?몄뀡 愿由?(以묐났 濡쒓렇??諛⑹?) ?????????????????????????????????
    match /user_sessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      allow list: if false;
    }

    // ?? ?ㅼ떆媛??좎? ?꾩튂 (100m 諛섍꼍 ?쒖떆?? ??????????????????????????
    match /user_locations/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ?? 怨듭쑀 ?꾪닾 HP ?곹깭 (?대씪?댁뼵???곌린 ?덉슜) ???????????????????????????????
    match /battle_hp/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ?? 1:1 怨좉컼 梨꾪똿 ????????????????????????????????????????????
    match /admin_status/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /support_chats/{uid} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;

      match /messages/{msgId} {
        allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow update: if isAdmin()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByUser"]));
        allow delete: if false;
      }
    }

    // ?? 湲곌린 1怨꾩젙 留ㅽ븨 (?듬챸 濡쒓렇?몄슜) ??????????????????????????????????????
    match /device_accounts/{deviceId} {
      // deviceId???대씪?댁뼵???앹꽦 ?쒕뜡 UUID ??異붿륫 遺덇??대?濡?怨듦컻 ?쎄린 ?덉슜
      allow get: if true;
      // ?먯떊??uid濡쒕쭔 ?앹꽦 媛?? ?섏젙/??젣 遺덇?
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ?? NFC 蹂대Ъ ?쒓렇 ?쒖뒪????????????????????????????????????????????????
    // ?쒓렇 怨듦컻 ?뺣낫 (?꾩튂쨌硫붿떆吏 ?? ??濡쒓렇???좎? ?꾧뎄???쎄린, ?곌린??Cloud Function ?꾩슜
    match /nfc_tags/{tagId} {
      allow get: if true;              // QR ?ㅼ틪 ??鍮꾨줈洹몄씤???쒓렇 怨듦컻 ?뺣낫 議고쉶 媛??
      allow list: if isAdmin();
      allow write: if false;           // Cloud Function only (adminSaveNfcTag ??
    }

    // ?섎졊 湲곕줉 ??蹂몄씤 湲곕줉留??쎄린, ?곌린??Cloud Function ?꾩슜
    match /nfc_claims/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;            // Cloud Function only (claimNfcTreasure)
    }

    // ?? ?좉퇋 ?좎? ?⑤낫???쒗넗由ъ뼹 諛뺤뒪 ???????????????????????????????????????
    // 蹂몄씤 ?곗씠?곕쭔 ?쎄린 媛?? ?곌린??Cloud Function ?꾩슜
    match /tutorial_boxes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false; // Cloud Function only (initTutorialBoxes, claimTutorialBox)
    }

    // ?? ?щ’ 癒몄떊 ??뙚 ? ????????????????????????????????????????????????????
    match /slot_config/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // ?ъ슜??蹂대Ъ (?ㅼ젣 醫뚰몴 鍮꾧났媛???Cloud Function留??묎렐)
    match /user_treasures/{docId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow write: if false; // Cloud Function only
    }

    // ?ъ슜??蹂대Ъ NPC (留??쒖떆????醫뚰몴 怨듦컻, 蹂대Ъ 醫뚰몴 ?쒖쇅)
    match /user_treasure_npcs/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // 蹂대Ъ ?⑦궎吏 (援щℓ???앹꽦 ??Cloud Function only write, 怨듦컻 ?쎄린)
    match /coopTreasurePackages/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // ?⑦궎吏 ?볤? (?꾧뎄???묒꽦, 蹂몄씤쨌愿由ъ옄留???젣)
    match /packageComments/{docId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ?? ?ㅽ넚?듭뀡 諛붿슦泥??????????????????????????????????????????????????????
    match /stockOptionVouchers/{docId} {
      allow get, list: if signedIn();          // 蹂몄씤 諛붿슦泥?議고쉶 (Cloud Function ?듯빐 ?꾪꽣)
      allow write: if false;                   // Cloud Function only
    }
    match /voucherTransfers/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /optionExecutions/{docId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // ?? Telegram Stars ?뺥쉶???쒖뒪????????????????????????????????????????????

    // 媛寃??ㅼ젙 ??濡쒓렇???좎? ?쎄린, 愿由ъ옄留??곌린
    match /membership_config/{docId} {
      allow get, list: if signedIn();
      allow write: if false; // Cloud Function only (adminSetMembershipPrice)
    }

    // 寃곗젣 湲곕줉 ??蹂몄씤 ?쎄린, CF留??곌린
    match /membership_payments/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // Cloud Function only (bot.py ??firebase-admin)
    }

    // 珥덈? 湲곕줉 ??蹂몄씤 ?쎄린, CF留??곌린
    match /membership_referrals/{docId} {
      allow get, list: if isAdmin()
        || (signedIn() && (
          resource.data.referrerUid == request.auth.uid
          || resource.data.newUserUid == request.auth.uid
        ));
      allow write: if false; // Cloud Function only
    }

    // ?湲?以?珥덈? ??bot.py(firebase-admin)媛 ?, 蹂몄씤 ?쎄린
    match /pending_referrals/{docId} {
      allow get: if signedIn() && request.auth.uid == docId;
      allow list: if isAdmin();
      allow write: if false; // Cloud Function only
    }

    // NPC 罹먮┃?????꾧뎄???쎄린, 愿由ъ옄留??곌린
    match /npc_characters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // NPC ?ㅼ?以꾨윭 ?곹깭 ??愿由ъ옄 ?쎄린, Cloud Function ?곌린(admin SDK)
    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

        // ------ BEST ERP SAAS RULES ------

    function isAuthenticated() { 
      return request.auth != null; 
    }

    function getUserData() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : {"role": "EMPLOYEE"};
    }

    // CEO ?먮뒗 理쒓퀬愿由ъ옄 ?뺤씤 (daguri75@gmail.com? 臾댁“嫄??곸슜)
    function isCEO() {
      return isAuthenticated() && (
        request.auth.token.email == 'daguri75@gmail.com' ||
        getUserData().role == 'SUPER_ADMIN' || 
        getUserData().role == 'CEO'
      );
    }
    
    // ?쇰컲 吏곸썝/愿由ъ옄 ?댁긽 (?곌린 沅뚰븳??
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.email == 'daguri75@gmail.com' ||
        getUserData().role in ['SUPER_ADMIN', 'CEO', 'ADMIN', 'STAFF']
      );
    }

    // 湲곕낯?곸쑝濡?CEO??紐⑤뱺 而щ젆?섏뿉???쎄린/?곌린/??젣 ?꾨꼍??沅뚰븳??媛吏?    

    // ?쇰컲 吏곸썝(Staff) ?댁긽??沅뚰븳
    match /materials/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /suppliers/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /priceHistory/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /externalPrices/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      // ?먯떊 ?뺣낫 ?섏젙 ?덉슜 ?먮뒗 CEO
      allow write: if request.auth.uid == userId || isCEO();
    }
    
    match /projects/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /purchaseRequests/{document=**} { allow read: if isAuthenticated(); allow write: if isAuthenticated(); }
    
    // ?덈줈 ?ㅺ퀎??AI 寃쎌쁺李몃え???듯빀 DB Rules
    match /employees/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /clients/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /contacts/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /siteLogs/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }
    match /aiInsights/{document=**} { allow read: if isAuthenticated(); allow write: if isStaff(); }

    // ?낅Т 諛?蹂닿퀬 ?쒖뒪??(Task Management System)
    match /system_branding/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isCEO();
    }

    match /tasks/{taskId} {
      allow read: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER' && resource.data.teamId == getUserData().teamId)
        || (isAuthenticated() && resource.data.assignedTo == request.auth.token.email);
      allow write: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER' && resource.data.teamId == getUserData().teamId)
        || (isAuthenticated() && resource.data.assignedTo == request.auth.token.email);
    }

    match /task_reports/{reportId} {
      allow read: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated() && resource.data.submittedBy == request.auth.uid);
      allow write: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated() && request.resource.data.submittedBy == request.auth.uid);
    }

    match /task_comments/{commentId} {
      allow read: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated());
      allow write: if isCEO() 
        || (isAuthenticated() && getUserData().role == 'TEAM_LEADER')
        || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    match /task_attachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /task_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
      // ------ END BEST ERP SAAS RULES ------

    match /{document=**} {
      allow read, write: if false;
    }
  
    // ====== MULTI-TENANT RESTAURANT SAAS RULES ======
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'daguri75@gmail.com';
    }

    function belongsToTenant(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().tenant_id == tenantId ||
        getUserData().merchantId == tenantId ||
        request.auth.uid == tenantId
      );
    }

    match /stores/{storeId} {
      allow read: if true; 
      allow write: if belongsToTenant(storeId);
    }

    match /menus/{menuId} {
      allow read: if true; 
      allow update, delete: if belongsToTenant(resource.data.tenantId);
      allow create: if belongsToTenant(request.resource.data.tenantId);
    }

    match /orders/{orderId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || belongsToTenant(resource.data.tenantId)));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if belongsToTenant(resource.data.tenantId);
      allow delete: if isSuperAdmin();
    }
      // --- 상품 연동 (BestERP/홈페이지) 컬렉션 ---
      match /merchant_products/{productId} {
        allow read: if true;
        allow create: if isAdmin() || isAuthenticated();
        allow update, delete: if isAdmin() || isAuthenticated();
      }

      match /merchant_orders/{orderId} {
        allow read: if isAdmin() || isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || isAuthenticated();
      }
  } // End of match /databases/{database}/documents
} // End of service cloud.firestore
