{
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "functions":  [
                      {
                          "source":  "functions",
                          "codebase":  "default",
                          "disallowLegacyRuntimeConfig":  true,
                          "predeploy":  [
                                            "node scripts/predeploy-check.cjs"
                                        ],
                          "ignore":  [
                                         "node_modules",
                                         ".git",
                                         "service_account.json",
                                         "**/service_account*.json",
                                         "firebase-debug.log",
                                         "firebase-debug.*.log"
                                     ]
                      }
                  ],
    "emulators":  {
                      "functions":  {
                                        "host":  "127.0.0.1",
                                        "port":  5002
                                    },
                      "ui":  {
                                 "enabled":  false
                             },
                      "singleProjectMode":  true
                  },
    "storage":  {
                    "rules":  "storage.rules"
                },
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "functions/**",
            "contract/**",
            "contract-deploy/**",
            "package-lock.json",
            "__pycache__/**",
            "*.py",
            "Dockerfile",
            "CLAUDE.md",
            "PROJECT_MAP.md",
            "SECURITY.md"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
